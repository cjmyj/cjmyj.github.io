source "https://rubygems.org"

# GitHub Pages 官方依赖集合（本地预览与线上保持一致）
gem "github-pages", group: :jekyll_plugins

# 如本地不需要复刻线上版本，也可直接用：
# gem "jekyll"

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Windows / JRuby 平台辅助
platforms :mingw, :x64_mingw do
  gem "tzinfo-data"
end